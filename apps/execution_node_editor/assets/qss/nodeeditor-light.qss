/*
  FlowNodeEditor — modern dark shell theme (Qt Widgets)
  Loaded after nodeeditor.qss in MainWindow.
*/

/* ---- palette tokens ---- */
/* bg0: deepest canvas; bg1: panels; bg2: elevated; line: hairlines; accent: cyan */

/* ---- global chrome ---- */
QMainWindow,
QDialog,
QFrame {
    border: 0;
    background: #121722;
}

QToolBar {
    border: 0;
    background: #151a24;
    spacing: 6px;
    padding: 4px 8px;
}

QToolBar QToolButton {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 6px;
    padding: 4px;
    color: #e6ebf2;
}

QToolBar QToolButton:hover {
    background: rgba(40, 218, 237, 0.12);
    border-color: rgba(40, 218, 237, 0.35);
}

QToolBar QToolButton:pressed {
    background: rgba(40, 218, 237, 0.18);
}

QStatusBar {
    background: #151a24;
    color: #a7b0bf;
    border-top: 1px solid #28324a;
}

QMenuBar {
    background: #151a24;
    border-bottom: 1px solid #28324a;
}

QMenuBar::item {
    spacing: 3px;
    padding: 6px 10px;
    color: #e6ebf2;
    background: transparent;
}

QMenuBar::item:selected,
QMenuBar::item:pressed {
    background: rgba(40, 218, 237, 0.14);
    border-radius: 6px;
}

QMenu {
    background: #1b2230;
    border: 1px solid #28324a;
    padding: 4px;
}

QMenu::item {
    padding: 6px 22px;
    color: #e6ebf2;
    background: transparent;
    border-radius: 6px;
}

QMenu::item:selected {
    background: rgba(40, 218, 237, 0.16);
}

QMenu::separator {
    height: 1px;
    margin: 4px 8px;
    background: #28324a;
}

QMenu::disabled,
QMenu::item:disabled {
    color: #6b7380;
}

/* ---- splitter (main vs side panel) ---- */
QSplitter::handle {
    background: #121722;
}

QSplitter::handle:horizontal {
    width: 5px;
    margin: 0 1px;
}

QSplitter::handle:vertical {
    height: 5px;
    margin: 1px 0;
}

QSplitter::handle:hover {
    background: rgba(40, 218, 237, 0.25);
}

/* ---- side panel tabs (NODES / Settings) ---- */
QTabWidget::pane {
    border: 1px solid #28324a;
    border-radius: 10px;
    margin-top: -1px;
    background: #151a24;
    top: -1px;
    /* Avoid a bright vertical seam on the far right edge of the side panel */
    margin-right: 0px;
    padding-right: 0px;
}

QTabBar {
    background: transparent;
}

QTabBar::tab {
    color: #a7b0bf;
    background: #121722;
    border: 1px solid #28324a;
    border-bottom-color: #28324a;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    min-width: 8ex;
    padding: 7px 14px;
    margin-right: 4px;
}

QTabBar::tab:selected {
    color: #e6ebf2;
    background: #151a24;
    border-bottom-color: #151a24;
}

QTabBar::tab:hover:!selected {
    color: #e6ebf2;
    background: #1b2230;
}

/* ---- MDI document tabs ---- */
QMdiArea {
    background: #0f131c;
}

QMdiSubWindow {
    border: 1px solid #28324a;
    border-radius: 10px;
    background: #0f131c;
}

QMdiArea QTabWidget::pane {
    border: 1px solid #28324a;
    border-radius: 10px;
    background: #0f131c;
}

QMdiArea QTabBar::tab {
    color: #a7b0bf;
    background: #121722;
    border: 1px solid #28324a;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    padding: 6px 12px;
    margin-right: 3px;
}

QMdiArea QTabBar::tab:selected {
    color: #e6ebf2;
    background: #0f131c;
    border-bottom-color: #0f131c;
}

QMdiArea QTabBar::tab:hover:!selected {
    background: #1b2230;
    color: #e6ebf2;
}

/* Scroll buttons on MDI tab bar (no embedded PNG deps) */
QMdiArea QTabBar QToolButton {
    background: #151a24;
    border: 1px solid #28324a;
    border-radius: 6px;
    padding: 2px 4px;
}

QMdiArea QTabBar QToolButton:hover {
    background: rgba(40, 218, 237, 0.12);
}

/* ---- node library ---- */
QTreeWidget {
    background: #151a24;
    color: #cfd6e6;
    border: 0;
    outline: 0;
    alternate-background-color: transparent;
    show-decoration-selected: 0;
}

QTreeWidget::item {
    padding: 3px 6px;
    border: 0;
    border-radius: 6px;
}

QTreeWidget::item:hover {
    background: rgba(40, 218, 237, 0.08);
}

QTreeWidget::item:selected {
    color: #ffffff;
    background: rgba(18, 148, 186, 0.35);
}

/* Branch / disclosure column: keep transparent so selection rounding doesn't leave "white tiles" */
QTreeView::branch {
    background: transparent;
    border: 0;
}

QHeaderView::section {
    background: #151a24;
    color: #a7b0bf;
    border: 0;
    padding: 6px;
}

/* ---- settings JSON editor ---- */
QPlainTextEdit,
QTextEdit {
    color: #e6ebf2;
    background: #0f131c;
    border: 1px solid #28324a;
    border-radius: 8px;
    padding: 8px;
    selection-background-color: rgba(40, 218, 237, 0.35);
    selection-color: #0b0f14;
}

QLineEdit {
    color: #e6ebf2;
    background: #0f131c;
    border: 1px solid #28324a;
    border-radius: 8px;
    padding: 6px 8px;
    selection-background-color: rgba(40, 218, 237, 0.35);
    selection-color: #0b0f14;
}

QLabel {
    color: #cfd6e6;
}

QPushButton {
    color: #e6ebf2;
    background: #1b2230;
    border: 1px solid #28324a;
    border-radius: 8px;
    padding: 7px 14px;
}

QPushButton:hover {
    background: rgba(40, 218, 237, 0.12);
    border-color: rgba(40, 218, 237, 0.45);
}

QPushButton:pressed {
    background: rgba(40, 218, 237, 0.18);
}

QPushButton:disabled {
    color: #6b7380;
    border-color: #28324a;
    background: #151a24;
}

/* Graphics view selection rubber band (if used) */
QGraphicsView {
    selection-background-color: rgba(40, 218, 237, 0.25);
}
